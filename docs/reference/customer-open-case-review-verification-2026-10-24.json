      "first_line": 10,
      "snippet": "public static Assessment assess(Instant received,Instant finalized,Instant observed){\n    if(received==null||observed==null)throw new IllegalArgumentException(\"미종결 감독의 접수·관측 시각이 필요합니다\");\n    Instant target=received.plus(Duration.ofHours(24));\n    boolean invalid=observed.isBefore(received)||(finalized!=null&&(finalized.isBefore(received)||finalized.isAfter(observed)));\n    boolean late=finalized==null?!observed.isBefore(target):finalized.isAfter(target);\n    return new Assessment(POLICY,target,invalid?State.TIME_REVIEW_REQUIRED:finalized!=null?State.CLOSED:late?State.OPEN_REVIEW_DUE:State.OPEN_WAITING,late);\n}"
    },
    {
      "source": "src/main/java/dustin/cex/domains/edd/CustomerReviewSupervisionService.java",
      "first_line": 24,
      "snippet": "public boolean requiresAttention(){return updateTarget.state()==CustomerReviewUpdateTarget.State.OVERDUE||updateTarget.state()==CustomerReviewUpdateTarget.State.TIME_REVIEW_REQUIRED||completionReview.state()==CustomerReviewCompletionTarget.State.OPEN_REVIEW_DUE||completionReview.state()==CustomerReviewCompletionTarget.State.TIME_REVIEW_REQUIRED||responseTarget.state()==CustomerReviewResponseTarget.State.OVERDUE||responseTarget.state()==CustomerReviewResponseTarget.State.TIME_REVIEW_REQUIRED||(finalReviewId!=null&&customerAcknowledgedAt==null)||(orphaned&&finalReviewId==null);}"
